{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://publicvpnlist.com/schema/wireguard-metadata-1.0.json",
  "title": "Synthetic-safe WireGuard server metadata",
  "description": "Future server-side WireGuard metadata. Client profiles and credentials are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "public_id",
    "protocol",
    "endpoint_host",
    "endpoint_ip",
    "endpoint_port",
    "country_code",
    "country_name",
    "city",
    "server_public_key",
    "distribution_mode",
    "provisioning_type",
    "source_name",
    "source_url",
    "source_license",
    "redistribution_allowed",
    "availability_status",
    "first_seen_at",
    "last_checked_at",
    "last_success_at",
    "technical_quality_score",
    "risk_flags",
    "server_page_url",
    "generation_page_url"
  ],
  "properties": {
    "public_id": {"type": "string", "pattern": "^pvl_[a-f0-9]{24}$"},
    "protocol": {"const": "wireguard"},
    "endpoint_host": {
      "anyOf": [
        {
          "type": "string",
          "format": "hostname",
          "pattern": "^(?=.{1,253}\\.?$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.?$",
          "minLength": 1,
          "maxLength": 253
        },
        {"type": "null"}
      ]
    },
    "endpoint_ip": {
      "anyOf": [
        {"type": "string", "format": "ipv4"},
        {"type": "string", "format": "ipv6"},
        {"type": "null"}
      ]
    },
    "endpoint_port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "country_code": {"type": ["string", "null"], "pattern": "^[A-Z]{2}$"},
    "country_name": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
    "city": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
    "asn": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
    "org": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
    "server_public_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$",
      "contentEncoding": "base64"
    },
    "distribution_mode": {
      "enum": ["metadata_only", "provider_generation_page"]
    },
    "provisioning_type": {
      "enum": ["none", "provider_managed", "manual_public_parameters"]
    },
    "source_name": {"type": "string", "minLength": 1, "maxLength": 160},
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^\\s]+$",
      "maxLength": 2048
    },
    "source_license": {"type": "string", "minLength": 1, "maxLength": 300},
    "redistribution_allowed": {"type": "boolean"},
    "allowed_ips_summary": {"type": ["string", "null"], "maxLength": 300},
    "persistent_keepalive": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535},
    "mtu": {"type": ["integer", "null"], "minimum": 576, "maximum": 9000},
    "availability_status": {
      "enum": ["online_at_last_check", "offline_at_last_check", "unknown"]
    },
    "handshake_ok": {"type": ["boolean", "null"]},
    "tunnel_ok": {"type": ["boolean", "null"]},
    "egress_ok": {"type": ["boolean", "null"]},
    "dns_ok": {"type": ["boolean", "null"]},
    "ping_ms": {"type": ["number", "null"], "minimum": 0},
    "jitter_ms": {"type": ["number", "null"], "minimum": 0},
    "packet_loss_percent": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 100
    },
    "download_mbps": {"type": ["number", "null"], "minimum": 0},
    "upload_mbps": {"type": ["number", "null"], "minimum": 0},
    "uptime_percent_24h": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "uptime_percent_7d": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "uptime_percent_30d": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "first_seen_at": {"type": "string", "format": "date-time"},
    "last_checked_at": {"type": "string", "format": "date-time"},
    "last_success_at": {"type": ["string", "null"], "format": "date-time"},
    "config_updated_at": {"type": ["string", "null"], "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "technical_quality_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "risk_flags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}
    },
    "server_page_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^\\s]+$",
      "maxLength": 2048
    },
    "generation_page_url": {
      "type": ["string", "null"],
      "format": "uri",
      "pattern": "^https://[^\\s]+$",
      "maxLength": 2048
    }
  }
}
