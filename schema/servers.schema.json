{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://publicvpnlist.com/schema/servers-1.0.json",
  "type": "object",
  "required": ["metadata", "records"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["dataset_version", "snapshot_id", "generated_at", "expires_at", "record_count", "schema_version", "checksum_sha256"],
      "properties": {
        "dataset_version": {"type": "string", "pattern": "^\\d{8}T\\d{6}Z-[a-f0-9]{12}$"},
        "record_count": {"type": "integer", "minimum": 1},
        "schema_version": {"const": "1.0"},
        "checksum_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "country_code", "protocol", "transport", "port", "technical_quality_score", "last_checked_at"],
        "not": {"anyOf": [{"required": ["server_id"]}, {"required": ["legacy_id"]}]},
        "properties": {
          "id": {"type": "string", "pattern": "^pvl_[a-f0-9]{24}$"},
          "country_code": {"type": ["string", "null"], "pattern": "^[A-Z]{2}$"},
          "protocol": {"const": "openvpn"},
          "transport": {"enum": ["tcp", "udp"]},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "technical_quality_score": {"type": "integer", "minimum": 0, "maximum": 100}
        }
      }
    }
  }
}
