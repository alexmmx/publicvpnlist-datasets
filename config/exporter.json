{
  "schema_version": "1.0",
  "fresh_max_age_seconds": 3600,
  "expires_after_seconds": 900,
  "next_update_after_seconds": 300,
  "accepted_checker_statuses": ["checked", "ok", "passed", "tunnel_ok"],
  "allowed_protocols": ["openvpn"],
  "supported_formats": ["json", "csv", "txt", "xml"],
  "output_root": "var/public-dataset",
  "lock_timeout_seconds": 10,
  "retention_versions": 3,
  "guardrails": {
    "minimum_record_count": 1,
    "minimum_countries_count": 1,
    "maximum_drop_percent": 30,
    "maximum_invalid_percent": 25
  }
}
